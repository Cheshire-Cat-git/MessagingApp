<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".presentation.main.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card to display notification details when app is opened via notification -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNotificationDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvNotificationType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notification Details"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sender: "
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        tools:text="John Doe" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Message: "
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        tools:text="Meeting at 5 PM" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutExpirationDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expiration Date: "
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvExpirationDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        tools:text="2026-12-31" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Header for Saved Notifications -->
        <TextView
            android:id="@+id/tvNotificationsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saved Notifications"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Empty view when no notifications -->
        <TextView
            android:id="@+id/tvEmptyNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No notifications received yet."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone" />

        <!-- RecyclerView for Saved Notifications -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="16dp"
            tools:listitem="@layout/item_notification_message" />

        <!-- Header for Data Messages -->
        <TextView
            android:id="@+id/tvDataMessagesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data Messages"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Empty view when no data messages -->
        <TextView
            android:id="@+id/tvEmptyDataMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No data messages received yet."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone" />

        <!-- RecyclerView for Data Messages -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDataMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_data_message" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
